# BCCh API credentials. Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.

# Preferred: personal API Key token (1-year validity).
# Get it from https://si3.bcentral.cl -> "Mi Cuenta" -> "Apikey Token"
BCCH_TOKEN=your_api_key_token

# Legacy alternative: registered email + password.
# Only needed if you are not using a token; leave blank when BCCH_TOKEN is set.
BCCH_USER=
BCCH_PASSWORD=
