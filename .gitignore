# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Build artifacts from `pip install -e .` and wheel builds
build/
dist/
*.egg-info/
.pytest_cache/

# Secrets -- never commit credentials.
# Everything under secrets/ is ignored except the tracked documentation, so the
# folder self-documents in a fresh clone while its contents stay local.
secrets/*
!secrets/.env.example
!secrets/README.md

# Belt and braces: these patterns catch credentials dropped anywhere else.
.env
.env.*
!secrets/.env.example
*token*.txt
*credentials*
*.pem
*.key

# Caches and data
data/cache/
data/cache_synthetic/

# Raw landing zone: large, regenerable from the API. The series universe and
# fetch manifest are kept because they document what a run selected and got.
data/raw/**/raw_*.csv

# Environments
.venv/
env/
venv/
ENV/

# IDE files
.idea/
.vscode/

# R
.Rhistory
.RData
.Rproj.user/
*.Rproj
